// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Report {
  id          Int      @id @default(autoincrement())
  imagePath   String
  description String?
  locationLat Float?
  locationLng Float?
  breed       String?
  age         String?
  animalType  String?
  tags        String? // JSON string
  status      String   @default("REPORTED") // REPORTED, IN_REVIEW, RESCUED, REUNITED
  createdAt   DateTime @default(now())

  // New fields
  condition   String? // JSON string
  collar      Boolean  @default(false)
  privacy     Boolean  @default(false) // true = obfuscated/approx location shown to public

  comments    Comment[]
  contactRequests ContactRequest[]
}

model Comment {
  id          Int      @id @default(autoincrement())
  text        String
  imagePath   String?
  createdAt   DateTime @default(now())
  reportId    Int
  report      Report   @relation(fields: [reportId], references: [id])
}

model ContactRequest {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  message     String?
  type        String?  // foster, transport, donate
  createdAt   DateTime @default(now())
  reportId    Int
  report      Report   @relation(fields: [reportId], references: [id])
}

model Vet {
  id          Int     @id @default(autoincrement())
  name        String
  address     String
  phone       String
  hours       String?
  locationLat Float?
  locationLng Float?
  website     String?
  specialties String? // JSON string e.g. ["cats", "dogs", "surgery"]
  emergency   Boolean @default(false)
  verified    Boolean @default(false)
}
